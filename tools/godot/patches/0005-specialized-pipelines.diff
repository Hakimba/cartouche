+uint64_t RenderForwardMobile::_specialized_pipelines_surface_key(uint32_t p_shader, uint64_t p_format, uint32_t p_surface) {
+	return hash_murmur3_one_64(p_format, hash_murmur3_one_32(p_surface, hash_murmur3_one_32(p_shader))) | (uint64_t(p_shader) << 32);
+}
+
+void RenderForwardMobile::_mesh_compile_specialized_pipelines_for_surface(const SurfacePipelineData &p_surface, const GlobalPipelineData &p_global, RSE::PipelineSource p_source) {
+	if (specialized_pipelines.is_empty()) {
+		return;
+	}
+
+	RendererRD::MeshStorage *mesh_storage = RendererRD::MeshStorage::get_singleton();
+	const RSE::PrimitiveType primitive = mesh_storage->mesh_surface_get_primitive(p_surface.mesh_surface);
+	const uint32_t surface = uint32_t(primitive) | (p_surface.instanced ? uint32_t(SpecializedPipeline::SURFACE_INSTANCED) : 0);
+	const LocalVector<SpecializedPipeline> *listed = specialized_pipelines.getptr(_specialized_pipelines_surface_key(p_surface.shader->code_hash, mesh_storage->mesh_surface_get_format(p_surface.mesh_surface), surface));
+	if (listed == nullptr) {
+		return;
+	}
+
+	const bool emulate_point_size = p_surface.shader->uses_point_size && scene_shader.emulate_point_size;
+	for (const SpecializedPipeline &pipeline : *listed) {
+		const bool use_post_pass = pipeline.words[SpecializedPipeline::WORD_TARGET] & SpecializedPipeline::TARGET_POST_PASS;
+		const bool use_hdr = pipeline.words[SpecializedPipeline::WORD_TARGET] & SpecializedPipeline::TARGET_HDR;
+		const RD::DataFormat buffers_color_format = use_hdr ? RD::DATA_FORMAT_R16G16B16A16_SFLOAT : _render_buffers_get_preferred_color_format();
+		const uint32_t samples = (pipeline.words[SpecializedPipeline::WORD_TARGET] & SpecializedPipeline::TARGET_PROJECT_SAMPLES) ? uint32_t(p_global.texture_samples) : pipeline.words[SpecializedPipeline::WORD_SAMPLES];
+
+		SceneShaderForwardMobile::ShaderData::PipelineKey pipeline_key;
+		pipeline_key.version = SceneShaderForwardMobile::ShaderVersion(pipeline.words[SpecializedPipeline::WORD_VERSION]);
+		pipeline_key.framebuffer_format_id = _get_color_framebuffer_format_for_pipeline(buffers_color_format, _render_buffers_can_be_storage(), RD::TextureSamples(samples), RD::TextureSamples(p_global.target_samples), false, use_post_pass, use_hdr, 1);
+		pipeline_key.vertex_format_id = mesh_storage->mesh_surface_get_vertex_format(p_surface.mesh_surface, p_surface.shader->get_vertex_input_mask(pipeline_key.version, false), p_surface.instanced, false, emulate_point_size);
+		pipeline_key.cull_mode = RD::PolygonCullMode(pipeline.words[SpecializedPipeline::WORD_CULL_MODE]);
+		pipeline_key.primitive_type = primitive;
+		pipeline_key.shader_specialization.packed_0 = pipeline.words[SpecializedPipeline::WORD_PACKED_0];
+		pipeline_key.shader_specialization.packed_1 = pipeline.words[SpecializedPipeline::WORD_PACKED_1];
+		memcpy(&pipeline_key.shader_specialization.packed_2, &pipeline.words[SpecializedPipeline::WORD_PACKED_2], sizeof(float));
+		pipeline_key.render_pass = pipeline.words[SpecializedPipeline::WORD_RENDER_PASS];
+		pipeline_key.wireframe = false;
+		pipeline_key.ubershader = false;
+		// Behind everything else: the frame that needs one first compiles it itself, and nothing waits for the others.
+		p_surface.shader->pipeline_hash_map.compile_pipeline(pipeline_key, pipeline_key.hash(), p_source, false);
+	}
+}
