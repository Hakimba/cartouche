+void RenderForwardMobile::_print_specialized_pipeline(SceneShaderForwardMobile::ShaderData *p_shader, void *p_mesh_surface, bool p_instanced_surface, const SceneShaderForwardMobile::ShaderData::PipelineKey &p_pipeline_key) {
+	{
+		MutexLock lock(specialized_pipelines_printed_mutex);
+		const uint64_t printed = uint64_t(p_pipeline_key.hash()) | (uint64_t(p_shader->code_hash) << 32);
+		if (specialized_pipelines_printed.has(printed)) {
+			return;
+		}
+		specialized_pipelines_printed.insert(printed);
+	}
+
+	if (p_pipeline_key.wireframe) {
+		return;
+	}
+
+	// The framebuffer format is a number of this run: which of the formats pipelines are compiled ahead for it is.
+	const RD::TextureSamples samples = RD::get_singleton()->framebuffer_format_get_texture_samples(p_pipeline_key.framebuffer_format_id, 0);
+	uint32_t target = UINT32_MAX;
+	for (uint32_t candidate = 0; candidate < 4; candidate++) {
+		const bool use_post_pass = candidate & SpecializedPipeline::TARGET_POST_PASS;
+		const bool use_hdr = candidate & SpecializedPipeline::TARGET_HDR;
+		const RD::DataFormat buffers_color_format = use_hdr ? RD::DATA_FORMAT_R16G16B16A16_SFLOAT : _render_buffers_get_preferred_color_format();
+		if (p_pipeline_key.framebuffer_format_id == _get_color_framebuffer_format_for_pipeline(buffers_color_format, _render_buffers_can_be_storage(), samples, RD::TextureSamples(global_pipeline_data_required.target_samples), false, use_post_pass, use_hdr, 1)) {
+			target = candidate;
+			break;
+		}
+	}
+	if (target == UINT32_MAX) {
+		return;
+	}
+	if (samples != RD::TEXTURE_SAMPLES_1 && uint32_t(samples) == global_pipeline_data_required.texture_samples) {
+		target |= SpecializedPipeline::TARGET_PROJECT_SAMPLES;
+	}
+
+	const uint64_t format = RendererRD::MeshStorage::get_singleton()->mesh_surface_get_format(p_mesh_surface);
+	uint32_t packed_2 = 0;
+	memcpy(&packed_2, &p_pipeline_key.shader_specialization.packed_2, sizeof(float));
+	const uint32_t words[SpecializedPipeline::WORD_COUNT] = {
+		p_shader->code_hash,
+		uint32_t(format),
+		uint32_t(format >> 32),
+		uint32_t(p_pipeline_key.primitive_type) | (p_instanced_surface ? uint32_t(SpecializedPipeline::SURFACE_INSTANCED) : 0),
+		uint32_t(p_pipeline_key.version),
+		uint32_t(samples),
+		target,
+		uint32_t(p_pipeline_key.cull_mode),
+		p_pipeline_key.shader_specialization.packed_0,
+		p_pipeline_key.shader_specialization.packed_1,
+		packed_2,
+		p_pipeline_key.render_pass,
+	};
+	String line = "Specialized pipeline:";
+	for (uint32_t word : words) {
+		line += " " + itos(int32_t(word));
+	}
+	print_line(line);
+}
