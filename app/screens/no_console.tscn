[node name="Hints" parent="." instance=ExtResource("hint_row")]

[node name="SettingsHint" type="Control" parent="Hints"]
layout_mode = 2
script = ExtResource("3")
button = &"y"
text = "Settings"

[connection signal="pressed" from="Add" to="." method="_on_add_pressed"]
