[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://screens/settings_menu.gd" id="1"]
[ext_resource type="PackedScene" path="res://screens/menu_row.tscn" id="2"]
[ext_resource type="Script" path="res://screens/button_hint.gd" id="3"]
[ext_resource type="PackedScene" path="res://screens/choice_list.tscn" id="4"]

[node name="SettingsMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.094, 0.102, 0.125, 0.42)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -300.0
offset_right = 300.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"FormPanel"

[node name="Items" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Panel/Items"]
layout_mode = 2
theme_type_variation = &"PanelTitle"
text = "Settings"
horizontal_alignment = 1

[node name="Platforms" parent="Panel/Items" instance=ExtResource("2")]
unique_name_in_owner = true
layout_mode = 2
label = "Platforms"

[node name="ButtonStyle" parent="Panel/Items" instance=ExtResource("2")]
unique_name_in_owner = true
layout_mode = 2
label = "Button style"

[node name="Graphics" parent="Panel/Items" instance=ExtResource("2")]
unique_name_in_owner = true
layout_mode = 2
label = "Graphics"

[node name="Region" parent="Panel/Items" instance=ExtResource("2")]
unique_name_in_owner = true
layout_mode = 2
label = "Preferred region of images"

[node name="Gap" type="Control" parent="Panel/Items"]
custom_minimum_size = Vector2(0, 12)
layout_mode = 2
mouse_filter = 2

[node name="Hint" type="PanelContainer" parent="Panel/Items"]
layout_mode = 2
size_flags_horizontal = 0
theme_type_variation = &"PlainHint"
script = ExtResource("3")
button = &"b"
text = "Close"

[connection signal="pressed" from="Panel/Items/Platforms" to="." method="_on_platforms_pressed"]
[connection signal="pressed" from="Panel/Items/ButtonStyle" to="." method="_on_button_style_pressed"]
[node name="Choice" parent="." instance=ExtResource("4")]
unique_name_in_owner = true
visible = false
layout_mode = 1

[connection signal="pressed" from="Panel/Items/Graphics" to="." method="_on_graphics_pressed"]
[connection signal="pressed" from="Panel/Items/Region" to="." method="_on_region_pressed"]
