msgid "No {platform} emulator is installed."
msgstr "No hay ningún emulador de {platform} instalado."

msgid "This game's file cannot be found: is its SD card or folder still there?"
msgstr "No se encuentra el archivo de este juego: ¿la tarjeta SD o la carpeta siguen ahí?"

msgid "The game could not be launched."
msgstr "No se pudo iniciar el juego."

msgid "Disc images · offline, resuming when the network is back"
msgstr "Imágenes de las etiquetas · sin conexión, se reanudará cuando vuelva la red"

msgid "Disc images · server unavailable, trying again later"
msgstr "Imágenes de las etiquetas · servidor no disponible, se reintentará más tarde"

