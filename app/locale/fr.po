msgid ""
msgstr ""
"Language: fr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "No {platform} emulator is installed."
msgstr "Aucun émulateur {platform} n’est installé."

msgid "This game's file cannot be found: is its SD card or folder still there?"
msgstr "Le fichier de ce jeu est introuvable : la carte SD ou le dossier est-il toujours là ?"

msgid "The game could not be launched."
msgstr "Le jeu n’a pas pu être lancé."

msgid "Disc images · offline, resuming when the network is back"
msgstr "Images des disques · hors ligne, reprise au retour du réseau"

msgid "Disc images · server unavailable, trying again later"
msgstr "Images des disques · serveur indisponible, nouvel essai plus tard"

msgid "Disc images · no room left on the device"
msgstr "Images des disques · plus de place sur la console"

msgid "Disc images · {done} / {total}"
msgstr "Images des disques · {done} / {total}"

msgid "Which button style?"
msgstr "Quel style de boutons ?"

msgid "This only changes how the buttons are drawn. The button that confirms is set in the device's settings."
msgstr "Ce choix change seulement le dessin des boutons. Le bouton qui valide se règle dans les paramètres de l'appareil."

msgid "For more immersion"
msgstr "Pour davantage d’immersion"

msgid "When you start a game, Cartouche puts up a black screen while the emulator starts. Android must allow it to “display over other apps”."
msgstr "Quand tu lances un jeu, Cartouche pose un écran noir le temps que l’émulateur démarre. Android doit l’autoriser à « s’afficher par-dessus les autres applis »."

msgid "Open the setting"
msgstr "Ouvrir le réglage"

msgid "Later"
msgstr "Plus tard"

msgid "No console yet"
msgstr "Aucune console pour l’instant"

msgid "Add a console"
msgstr "Ajouter une console"

msgid "Type"
msgstr "Type"

msgid "Emulator"
msgstr "Émulateur"

msgid "Games folder"
msgstr "Dossier des jeux"

msgid "Choose…"
msgstr "Choisir…"

msgid "None installed"
msgstr "Aucun installé"

msgid "Install an emulator for this console, then come back."
msgstr "Installe un émulateur pour cette console, puis reviens."

msgid "Accepted files: {extensions}"
msgstr "Fichiers acceptés : {extensions}"

msgid "No compatible game in this folder"
msgstr "Aucun jeu compatible dans ce dossier"

msgid "Subfolders"
msgstr "Sous-dossiers"

msgid "Group the discs of a game"
msgstr "Regrouper les disques d’un même jeu"

msgid "Cancel"
msgstr "Annuler"

msgid "Add"
msgstr "Ajouter"

msgid "The console could not be added."
msgstr "La console n’a pas pu être ajoutée."

msgid "{console} added"
msgstr "{console} ajoutée"

msgid "SD card"
msgstr "Carte SD"

msgid "Internal storage"
msgstr "Mémoire interne"

msgid "{count} compatible game found"
msgid_plural "{count} compatible games found"
msgstr[0] "{count} jeu compatible trouvé"
msgstr[1] "{count} jeux compatibles trouvés"

msgid "Press a button"
msgstr "Appuie sur un bouton"

msgid "Continue"
msgstr "Continuer"

msgid "Settings"
msgstr "Réglages"

msgid "Platforms"
msgstr "Plateformes"

msgid "Button style"
msgstr "Style de boutons"

msgid "Close"
msgstr "Fermer"

msgid "Back"
msgstr "Retour"

msgid "Edit the platform"
msgstr "Modifier la plateforme"

msgid "Remove"
msgstr "Supprimer"

msgid "Save"
msgstr "Enregistrer"

msgid "Remove {platform}?"
msgstr "Supprimer {platform} ?"

msgid "Its {count} game, its image and the access to its folder will be removed from Cartouche."
msgid_plural "Its {count} games, their images and the access to its folder will be removed from Cartouche."
msgstr[0] "Son {count} jeu, son image et l’accès à son dossier seront retirés de Cartouche."
msgstr[1] "Ses {count} jeux, leurs images et l’accès à son dossier seront retirés de Cartouche."

msgid "Your game files stay on the SD card."
msgstr "Tes fichiers de jeux restent sur la carte SD."

msgid "Your game files stay in the internal storage."
msgstr "Tes fichiers de jeux restent dans la mémoire interne."

msgid "Your game files stay where they are."
msgstr "Tes fichiers de jeux restent là où ils sont."

msgid "The console could not be removed."
msgstr "La console n’a pas pu être supprimée."

msgid "Its choices and the access to its folder will be removed from Cartouche."
msgstr "Ses réglages et l’accès à son dossier seront retirés de Cartouche."

msgid "Add a platform"
msgstr "Ajouter une plateforme"
