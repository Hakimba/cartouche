msgid "No {platform} emulator is installed."
msgstr "Non è installato alcun emulatore {platform}."

msgid "This game's file cannot be found: is its SD card or folder still there?"
msgstr "Impossibile trovare il file di questo gioco: la scheda SD o la cartella ci sono ancora?"

msgid "The game could not be launched."
msgstr "Impossibile avviare il gioco."

msgid "Disc images · offline, resuming when the network is back"
msgstr "Immagini delle etichette · offline, riprende quando torna la rete"

msgid "Disc images · server unavailable, trying again later"
msgstr "Immagini delle etichette · server non disponibile, nuovo tentativo più tardi"

