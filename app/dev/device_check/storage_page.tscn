[gd_scene format=3 uid="uid://uvaf2eqf2kf2"]

[ext_resource type="Script" uid="uid://cgsw1m64ptq8i" path="res://dev/device_check/storage_page.gd" id="1"]

[node name="Storage" type="VBoxContainer"]
script = ExtResource("1")

[node name="Access" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2

[node name="Buttons" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Grant" type="Button" parent="Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Grant all files access"

[node name="GrantOverlay" type="Button" parent="Buttons"]
layout_mode = 2
text = "Allow display over other apps"

[node name="AddFolder" type="Button" parent="Buttons"]
layout_mode = 2
text = "Add a folder…"

[node name="Refresh" type="Button" parent="Buttons"]
layout_mode = 2
text = "Refresh"

[node name="Hint" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"Hint"
text = "Folders whose access is kept (they must survive an app restart):"

[node name="Folders" type="ItemList" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[connection signal="pressed" from="Buttons/Grant" to="." method="_on_grant_pressed"]
[connection signal="pressed" from="Buttons/GrantOverlay" to="." method="_on_grant_overlay_pressed"]
[connection signal="pressed" from="Buttons/AddFolder" to="." method="_on_add_folder_pressed"]
[connection signal="pressed" from="Buttons/Refresh" to="." method="refresh"]
